# Database (MySQL). Prisma and the app both connect with this.
# Percent-encode the user and password: `$` as %24, `@` as %40, `#` as %23, `&` as %26, `!` as %21, `*` as %2A, `^` as %5E.
# (A plain `$` would be expanded as a variable when .env is read, cutting the password short.)
DATABASE_URL="mysql://root:@127.0.0.1:3306/giti"

# Or instead of DATABASE_URL, the parts separately (same encoding rule for `$`: write it as `\$`):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=giti
# DB_USERNAME=root
# DB_PASSWORD=

# Signs the admin panel session cookie. Generate one per environment: openssl rand -base64 32
SESSION_SECRET=""

# The session cookie is HTTPS-only in production. Uncomment while the site is served over plain HTTP.
# SESSION_SECURE_COOKIE=false

# The site's public address, for the language versions search engines are told about. Example: https://giti.example.com
# SITE_URL=
