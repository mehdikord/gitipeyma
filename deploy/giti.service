[Unit]
Description=GITI Next.js service
After=network.target

[Service]
Type=simple
User=cloner
WorkingDirectory=/home/cloner/Projects/giti
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/home/cloner/.nvm/versions/node/v26.3.0/bin/node node_modules/next/dist/bin/next start --hostname 0.0.0.0
SuccessExitStatus=143
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
